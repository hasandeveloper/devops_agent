DATABASE_URL=postgresql+psycopg://devops_agent:devops_agent@localhost:5433/devops_agent

# Celery broker for alarm dispatch (app/tasks.py) -- points at a Redis instance
# you run yourself, this project doesn't manage one.
CELERY_BROKER_URL=redis://localhost:6379/0

# Every AWS call the RDS MCP server makes (mcp_server.py, via config/aws.py's
# get_boto3_client()) goes through these Settings fields, not boto3's own default
# credential chain -- required when running via `docker compose up`, since there's
# no host ~/.aws inside the container. Leave the key/secret blank outside Docker
# to fall back to a configured AWS CLI profile instead; AWS_REGION still applies
# either way (defaults to ap-south-1 if unset).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Standard Python logging level names: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Set to true to auto-confirm SNS subscription handshakes (CloudWatch Alarms -> SNS -> this service)
SNS_AUTO_CONFIRM_SUBSCRIPTIONS=true

# Optional shared secret checked against a header on the GitHub Actions webhook
GITHUB_WEBHOOK_SECRET=

# Incoming Webhook URL diagnoses (and HITL remediation approval buttons) get posted
# to -- see documentation/devops/slack/slack.md for how to create it.
SLACK_WEBHOOK_URL=
# Verifies POST /webhooks/slack/interactions (the remediation Approve/Reject/Approve-All
# button clicks) actually came from Slack -- from the Slack app's Basic Information page,
# NOT the incoming webhook URL above. Required once Interactivity is enabled; see
# documentation/rds-agent/3.hitl-remediation-phase-1-cancel-query.md.
SLACK_SIGNING_SECRET=

# Optional: trace every LangChain/LangGraph call (diagnose LLM call, retrieval, etc.) to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# App database connections for the RDS domain agent's DB diagnostic tools
# (get_active_connections, get_lock_waits, explain_query_for_pid). Which block
# gets used for a given alarm is resolved at runtime from that alarm's
# CloudWatch "environment" tag (dev/stag/production) via get_alarm_environment
# -- these are READONLY credentials for a dedicated role (e.g.
# devops_agent_readonly, member of pg_read_all_stats only), never the
# application's own full-access DB user/password.
DB_DEV_HOST=
DB_DEV_PORT=5432
DB_DEV_DATABASE=
DB_DEV_READONLY_USERNAME=
DB_DEV_READONLY_PASSWORD=

DB_STAGING_HOST=
DB_STAGING_PORT=5432
DB_STAGING_DATABASE=
DB_STAGING_READONLY_USERNAME=
DB_STAGING_READONLY_PASSWORD=

DB_PRODUCTION_HOST=
DB_PRODUCTION_PORT=5432
DB_PRODUCTION_DATABASE=
DB_PRODUCTION_READONLY_USERNAME=
DB_PRODUCTION_READONLY_PASSWORD=

# Write-capable credentials for the RDS domain agent's HITL remediation tools
# (cancel_backend, via app/agents/tools/mcp/rds/remediation_mcp_server.py) -- a
# SEPARATE role from DB_*_READONLY_* above, granted membership in
# pg_signal_backend (to call pg_cancel_backend) AND pg_read_all_stats (to read
# other sessions' query text for the pre-cancel safety check) -- never superuser.
# Same host/port/database as the readonly block for that environment. See
# documentation/rds-agent/1.your-rds-readonly-db-role-setup.md Section 7.
DB_DEV_REMEDIATION_USERNAME=
DB_DEV_REMEDIATION_PASSWORD=

DB_STAGING_REMEDIATION_USERNAME=
DB_STAGING_REMEDIATION_PASSWORD=

DB_PRODUCTION_REMEDIATION_USERNAME=
DB_PRODUCTION_REMEDIATION_PASSWORD=

# A query running longer than this many seconds is a candidate for the cancel-query
# remediation. Only checked on alarms diagnosed as medium/high risk.
REMEDIATION_LONG_QUERY_THRESHOLD_SECONDS=60
